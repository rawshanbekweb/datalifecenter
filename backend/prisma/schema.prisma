generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ContentType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  FREE
  UNPAID
  PENDING
  PAID
  REJECTED
  REFUNDED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

// Kurs qaysi shaklda o'tiladi. HYBRID — o'quvchi ikkalasidan birini tanlaydi.
enum CourseFormat {
  ONLINE
  OFFLINE
  HYBRID
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  phone        String?
  role         Role         @default(STUDENT)
  isBlocked    Boolean      @default(false)
  avatarUrl    String?
  // Parol o'zgarganda oshiriladi — eski JWT sessiyalari darhol bekor bo'ladi
  tokenVersion Int          @default(0)
  emailVerifiedAt DateTime?
  mentorProfile Mentor?
  enrollments  Enrollment[]
  subscriptions Subscription[]
  lessonProgress LessonProgress[]
  lessonQuestions LessonQuestion[]
  assignmentSubmissions AssignmentSubmission[]
  courseReviews CourseReview[]
  notifications Notification[]
  conversations ConversationParticipant[]
  sentMessages  Message[]
  courseRequests CourseRequest[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Email tasdiqlash — parol tiklash bilan bir xil naqsh (faqat hash saqlanadi)
model EmailVerificationToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Parolni tiklash: xom token emas, faqat sha256 hash saqlanadi
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Mentor {
  id            String   @id @default(cuid())
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?  @unique
  name          String
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  bio           Json
  photoUrl      String?
  specialty     Json
  position      Json?
  linkedinUrl   String?
  githubUrl     String?
  telegramUrl   String?
  order         Int      @default(0)
  featured      Boolean  @default(false)
  courses       Course[]
  blogPosts     BlogPost[]
  liveSessions  LiveSession[]
  assignments   Assignment[]
  requests      MentorRequest[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Course {
  id             String       @id @default(cuid())
  slug           String       @unique
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}. slug doim title.uz'dan hosil qilinadi.
  title          Json
  subtitle       Json?
  description    Json
  iconKey        String
  color          String
  bg             String
  border         String
  price          Decimal?
  isFree         Boolean      @default(true)
  currency       String       @default("UZS")
  durationMonths Int
  level          Level        @default(BEGINNER)
  // ONLINE kursga o'quvchi o'zi yozilaveradi; OFFLINE'da yozilish admin
  // orqali kechadi (CourseRequest). HYBRID'da tanlovni o'quvchi qiladi.
  format         CourseFormat @default(ONLINE)
  // Offline mashg'ulot manzili — ko'p tilli matn {uz, ru?, kaa?, en?}
  location       Json?
  rating         Float        @default(0)
  reviewsCount   Int          @default(0)
  studentsCount  Int          @default(0)
  views          Int          @default(0)
  likesCount     Int          @default(0)
  tags           String[]
  published      Boolean      @default(false)
  mentor         Mentor?      @relation(fields: [mentorId], references: [id])
  mentorId       String?
  modules        Module[]
  enrollments    Enrollment[]
  liveSessions   LiveSession[]
  assignments    Assignment[]
  announcements  Announcement[]
  reviews        CourseReview[]
  requests       CourseRequest[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CourseReview {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  rating    Int
  comment   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model LiveSession {
  id          String        @id @default(cuid())
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title       Json
  description Json?
  meetingUrl  String
  startsAt    DateTime
  durationMin Int           @default(60)
  status      SessionStatus @default(SCHEDULED)
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  mentor      Mentor        @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId    String
  // Bo'sh massiv = kursga yozilgan barcha faol o'quvchiga ochiq (standart).
  // To'ldirilsa — faqat shu userId'lar ko'radi (mentor aniq o'quvchilarni tanlagan).
  targetStudentIds String[] @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([courseId, startsAt])
}

model Module {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title       Json
  description Json?
  order       Int
  lessons     Lesson[]
}

model Lesson {
  id              String      @id @default(cuid())
  module          Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId        String
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title           Json
  order           Int
  contentType     ContentType @default(VIDEO)
  videoUrl        String?
  content         Json?
  durationMinutes Int?
  isFreePreview   Boolean     @default(false)
  progress        LessonProgress[]
  questions       LessonQuestion[]
}

// O'quvchi ↔ mentor muloqoti: dars ostidagi savol-javob
model LessonQuestion {
  id         String    @id @default(cuid())
  lesson     Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId   String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  body       String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([lessonId, createdAt])
  @@index([userId])
}

enum MentorRequestStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  ACCEPTED
  RETURNED
}

// Mentor ↔ o'quvchi: kurs bo'yicha topshiriq (vazifa berish va tekshirish).
// Savol-javob (LessonQuestion) kabi to'g'ridan-to'g'ri muloqot kanali —
// shu sabab matnlar ko'p tilli Json emas, oddiy String.
model Assignment {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  mentor      Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId    String
  title       String
  description String
  // Qo'shimcha material havolasi (Google Docs, GitHub va h.k.)
  linkUrl     String?
  dueAt       DateTime?
  // Bo'sh massiv = kursga yozilgan barcha faol o'quvchiga (LiveSession patterni)
  targetStudentIds String[] @default([])
  submissions AssignmentSubmission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, createdAt])
  @@index([mentorId])
}

// O'quvchining topshiriq javobi. RETURNED bo'lsa qayta topshirish mumkin,
// ACCEPTED — yakuniy (o'zgartirib bo'lmaydi).
model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  content      String
  linkUrl      String?
  fileUrl      String?
  status       SubmissionStatus @default(SUBMITTED)
  grade        Int?
  feedback     String?
  reviewedAt   DateTime?
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId])
}

// Mentor ↔ admin aloqasi: mentorning rasmiy so'rovlari
model MentorRequest {
  id        String              @id @default(cuid())
  mentor    Mentor              @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId  String
  subject   String
  body      String
  status    MentorRequestStatus @default(OPEN)
  reply     String?
  repliedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([mentorId])
}

enum ConversationKind {
  // Ikki aniq foydalanuvchi orasidagi yozishma (talaba ↔ mentor)
  DIRECT
  // "Administratsiya" kanali — uni boshlagan foydalanuvchi bir tomonda,
  // ikkinchi tomonda esa BARCHA adminlar. Aniq admin biriktirilmaydi:
  // xabar javobsiz qolmasligi kerak, kim bo'sh bo'lsa o'sha javob beradi.
  ADMIN
}

/**
 * Rollar aro to'g'ridan-to'g'ri yozishma.
 *
 * Loyihada allaqachon uchta muloqot kanali bor edi (dars ostidagi savol,
 * mentorning adminga so'rovi, ochiq kontakt formasi) — lekin ularning
 * hech biri suhbat emas: har birida bitta savol va bitta javob maydoni.
 * Bu model o'sha kanallarni ALMASHTIRMAYDI, ular o'z kontekstida qoladi;
 * bu esa kontekstsiz, ko'p xabarli yozishma uchun.
 */
model Conversation {
  id            String                    @id @default(cuid())
  kind          ConversationKind          @default(DIRECT)
  /// Takroriy suhbat ochilmasligi uchun hisoblanadigan noyob kalit:
  /// DIRECT uchun "direct:<userId1>:<userId2>" (id'lar saralangan),
  /// ADMIN uchun "admin:<userId>". Noyoblik bazada — parallel ikki
  /// so'rov ham bitta suhbatga tushadi (upsert).
  pairKey       String                    @unique
  lastMessageAt DateTime                  @default(now())
  participants  ConversationParticipant[]
  messages      Message[]
  createdAt     DateTime                  @default(now())

  @@index([lastMessageAt])
}

// Suhbat ishtirokchisi va uning o'qish holati.
// ADMIN turidagi suhbatda adminlar uchun bu yozuv suhbat birinchi marta
// ochilganda yaratiladi — aks holda har yangi admin uchun barcha eski
// suhbatlarga yozuv qo'shib chiqish kerak bo'lardi.
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum CourseRequestStatus {
  NEW
  CONTACTED
  ENROLLED
  REJECTED
}

/**
 * Kursga qiziqqan odamning adminga so'rovi — ayniqsa OFFLINE kurslar uchun.
 *
 * Offline guruhga o'quvchi o'zi "yozilib" qo'ya olmaydi: joy, jadval va
 * to'lov admin bilan kelishiladi. Shuning uchun bu Enrollment emas —
 * to'lov/progress tizimiga tegmaydigan alohida murojaat.
 *
 * `userId` ixtiyoriy: saytga kirmagan mehmon ham telefon qoldirib
 * so'rov yubora oladi (aynan shu odamlar keyin ro'yxatdan o'tadi).
 */
model CourseRequest {
  id        String              @id @default(cuid())
  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  // O'quvchi tanlagan format — kurs HYBRID bo'lganda aynan shu qiymat muhim
  format    CourseFormat
  name      String
  phone     String
  email     String?
  note      String?
  status    CourseRequestStatus @default(NEW)
  reply     String?
  repliedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([courseId])
}

enum NotificationType {
  QUESTION_ANSWERED
  NEW_QUESTION
  ENROLLMENT_ACTIVATED
  RECEIPT_SUBMITTED
  MENTOR_REQUEST_REPLIED
  NEW_MENTOR_REQUEST
  SESSION_SCHEDULED
  ANNOUNCEMENT
  PAYMENT_REJECTED
  SUBSCRIPTION_ACTIVATED
  NEW_ASSIGNMENT
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_REVIEWED
  NEW_MESSAGE
  NEW_COURSE_REQUEST
}

// Kabinet ichidagi bildirishnomalar — har bir yozuv bitta foydalanuvchiga tegishli
model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  MENTORS
}

// Admin e'lonlari — yaratilganda auditoriyaga Notification sifatida tarqatiladi
model Announcement {
  id        String               @id @default(cuid())
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title     Json
  body      Json
  audience  AnnouncementAudience @default(ALL)
  course    Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId  String?
  createdAt DateTime             @default(now())
}

model LessonProgress {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String?
  category   String
  order      Int      @default(0)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Project {
  id            String   @id @default(cuid())
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title         Json
  category      String
  description   Json
  techStack     String[]
  screenshotUrl String
  liveUrl       String?
  repoUrl       String?
  // true bo'lsa kartada skrinshot o'rniga liveUrl to'g'ridan-to'g'ri iframe orqali
  // "jonli" ko'rsatiladi — ba'zi saytlar (X-Frame-Options/CSP) buni bloklashi mumkin,
  // shu holatlarda admin buni o'chirib skrinshotga qaytishi kerak.
  liveEmbed     Boolean  @default(false)
  order         Int      @default(0)
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  views         Int      @default(0)
  likesCount    Int      @default(0)
  createdAt     DateTime @default(now())
}

model Enrollment {
  id              String               @id @default(cuid())
  user            User                 @relation(fields: [userId], references: [id])
  userId          String
  course          Course               @relation(fields: [courseId], references: [id])
  courseId        String
  status          EnrollmentStatus     @default(PENDING)
  paymentStatus   PaymentStatus        @default(UNPAID)
  provider        String?
  providerRef     String?
  amountPaid      Decimal?
  receiptUrl      String?
  rejectionReason String?
  enrolledAt      DateTime             @default(now())
  completedAt     DateTime?
  transactions    PaymentTransaction[]

  @@unique([userId, courseId])
}

enum PaymentProvider {
  CLICK
  PAYME
}

enum PaymentTxState {
  CREATED
  PERFORMED
  CANCELLED
  CANCELLED_AFTER_PERFORM
}

// Payme/Click webhook'lari orqali keladigan to'lov shlyuzi tranzaksiyasi holati.
// Ikkala protokol ham idempotentlikni talab qiladi — bir xil so'rov qayta kelsa
// bir xil javob qaytarilishi SHART, shuning uchun holat alohida saqlanadi.
model PaymentTransaction {
  id             String          @id @default(cuid())
  provider       PaymentProvider
  providerTxId   String
  // Aynan bittasi to'ldiriladi — buyurtma yo kurs yozilishi, yo obuna uchun
  enrollment     Enrollment?     @relation(fields: [enrollmentId], references: [id])
  enrollmentId   String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  amount         Decimal
  state          PaymentTxState  @default(CREATED)
  reason         Int?
  createTime     DateTime        @default(now())
  performTime    DateTime?
  cancelTime     DateTime?

  @@unique([provider, providerTxId])
  @@index([enrollmentId])
  @@index([subscriptionId])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

// Oylik obuna — faol bo'lsa barcha nashr qilingan kurslarga kirish beradi.
// Har bir kurs uchun alohida Enrollment avtomatik provisioning qilinadi
// (subscriptions.service.ts) — progress/sertifikat/jonli-dars/sharh
// tizimlariga tegilmasligi uchun.
model Subscription {
  id              String               @id @default(cuid())
  user            User                 @relation(fields: [userId], references: [id])
  userId          String
  status          SubscriptionStatus   @default(PENDING)
  startsAt        DateTime?
  expiresAt       DateTime?
  amountPaid      Decimal?
  provider        String?
  providerRef     String?
  receiptUrl      String?
  rejectionReason String?
  createdAt       DateTime             @default(now())
  transactions    PaymentTransaction[]

  @@index([userId])
}

// Bosh sahifa bo'limlari (hero_stats, about, services, why_us, contact) uchun
// admin tomonidan tahrirlanadigan tarkib — har bir bo'lim JSON blob sifatida saqlanadi.
model SiteSetting {
  id        String   @id @default(cuid())
  section   String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  role      Json
  avatarUrl String?
  text      Json
  rating    Int      @default(5)
  published Boolean  @default(true)
  order     Int      @default(0)
  likesCount Int     @default(0)
  createdAt DateTime @default(now())
}

// Yoqtirish/ko'rish hisoblagichlari qo'llanadigan kontent turlari.
// Polimorf yondashuv ATAYIN tanlangan: har bir tur uchun alohida Like jadvali
// (BlogPostLike, ProjectLike...) bir xil kodni to'rt marta takrorlashni talab
// qilardi. Buning evaziga foreign key yo'q — kontent o'chirilganda unga
// tegishli yozuvlar `engagement.service.ts` dagi `purgeEngagement()` orqali
// qo'lda tozalanadi.
// ESLATMA: `ContentType` nomi allaqachon band (Lesson uchun VIDEO/TEXT/...),
// shu sabab bu yerda `EngagementTarget` ishlatiladi.
enum EngagementTarget {
  BLOG_POST
  PROJECT
  COURSE
  TESTIMONIAL
}

// Bitta qurilmaning bitta kontentga qo'ygan yoqtirishi.
// `deviceId` — httpOnly cookie'dagi tasodifiy identifikator (login talab
// qilinmaydi): mehmon ham yoqtira olishi kerak. Cookie tozalansa qayta
// yoqtirish mumkin — bu ongli murosa, qat'iy noyoblik uchun login shart bo'lardi.
model ContentLike {
  id          String           @id @default(cuid())
  contentType EngagementTarget
  contentId   String
  deviceId    String
  createdAt   DateTime         @default(now())

  // Bir qurilma bir kontentni faqat bir marta yoqtira oladi — takroriy
  // bosish yozuvni o'chiradi (toggle)
  @@unique([contentType, contentId, deviceId])
  // Kontent bo'yicha sanash va o'chirish uchun
  @@index([contentType, contentId])
}

// Ko'rishlar dublikatini to'sish uchun.
//
// Ilgari bu blogda `bv_<id>` cookie'si bilan qilinardi — lekin frontend va
// backend turli domenlarda (vercel.app / datalife.uz ↔ onrender.com) va
// Safari krossdomen cookie'ni bloklaydi: o'sha brauzerlarda har yangilashda
// ko'rishlar soni oshib ketardi. Endi hisob `deviceId` (localStorage'dagi
// identifikator, `X-Device-Id` header orqali) bo'yicha bazada tekshiriladi.
model ContentView {
  id          String           @id @default(cuid())
  contentType EngagementTarget
  contentId   String
  deviceId    String
  // Oxirgi hisoblangan vaqt — 24 soatdan keyin ko'rish qayta sanaladi
  viewedAt    DateTime         @default(now())

  @@unique([contentType, contentId, deviceId])
  @@index([contentType, contentId])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model BlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}. slug doim title.uz'dan hosil qilinadi.
  title        Json
  excerpt      Json
  content      Json
  category     String
  iconKey      String
  color        String
  bg           String
  border       String
  readMinutes  Int       @default(5)
  // Hisoblagichlar ATAYIN denormallashtirilgan (ContentLike'dan COUNT emas):
  // ro'yxat endpointlari yuklama ostida har element uchun sanashga chidamaydi
  views        Int       @default(0)
  likesCount   Int       @default(0)
  tags         String[]
  published    Boolean   @default(false)
  mentor       Mentor?   @relation(fields: [mentorId], references: [id])
  mentorId     String?
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
