generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MENTOR
  // Kompaniya xodimi — o'z jamoa profilini tahrirlaydigan kabinetga kiradi.
  // MENTOR'dan farqi: o'quv jarayoniga (kurs/dars/topshiriq) aloqasi yo'q.
  TEAM
  ADMIN
}

// Jamoa a'zosi qaysi bo'limda ishlaydi — ommaviy /team sahifasi shu bo'yicha guruhlanadi
enum Department {
  LEADERSHIP
  ENGINEERING
  DATA
  DESIGN
  MARKETING
  EDUCATION
  OPERATIONS
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ContentType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

/**
 * Yozilishning pul holati. FREE/PAID/PARTIAL/UNPAID qiymatlari to'lov
 * daftaridan (EnrollmentPayment) HOSIL QILINADI — ularni qo'lda yozmang,
 * enrollmentPayments.service.ts dagi recalcEnrollmentPayment ishlatiladi.
 *
 * PENDING va REJECTED daftardan tashqarida: bular chek yuklab, admin
 * tasdiqini kutish oqimi (submitReceipt) — hali pul kelmagan holat.
 */
enum PaymentStatus {
  FREE
  UNPAID
  // Qisman to'langan — qarzi bor, lekin o'qishdan to'xtatilmaydi
  PARTIAL
  PENDING
  PAID
  REJECTED
  REFUNDED
}

// To'lov qanday qabul qilingani. ONLINE — Click/Payme (PaymentTransaction
// bilan keladi), qolganlari markazda qo'lda qayd etiladi.
enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
  OTHER
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

// Kurs qaysi shaklda o'tiladi. HYBRID — o'quvchi ikkalasidan birini tanlaydi.
enum CourseFormat {
  ONLINE
  OFFLINE
  HYBRID
}

// Aynan bitta yozilish qaysi guruhda — CourseFormat'dan farqli, bu yerda
// HYBRID yo'q: kurs ikki shaklda o'tilishi mumkin, lekin bitta o'quvchi
// baribir bitta guruhda o'qiydi.
enum EnrollmentFormat {
  ONLINE
  OFFLINE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  phone        String?
  role         Role         @default(STUDENT)
  isBlocked    Boolean      @default(false)
  avatarUrl    String?
  // Rasm doira/kvadrat kadrga kesilganda markazda qoladigan nuqta (foizda).
  // NEGA KERAK: portret suratda yuz yuqori qismda bo'ladi, sukutdagi 50/50
  // kesish esa o'rtani oladi — natijada boshning yarmi kadrdan chiqib ketadi.
  focusX       Int          @default(50)
  focusY       Int          @default(50)
  // Parol o'zgarganda oshiriladi — eski JWT sessiyalari darhol bekor bo'ladi
  tokenVersion Int          @default(0)
  emailVerifiedAt DateTime?
  mentorProfile Mentor?
  enrollments  Enrollment[]
  subscriptions Subscription[]
  lessonProgress LessonProgress[]
  lessonQuestions LessonQuestion[]
  assignmentSubmissions AssignmentSubmission[]
  courseReviews CourseReview[]
  notifications Notification[]
  conversations ConversationParticipant[]
  sentMessages  Message[]
  courseRequests CourseRequest[]
  teamProfile  TeamMember?
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sessions     Session[]
  // Bu admin qabul qilgan to'lovlar (kassa yozuvlari)
  recordedPayments EnrollmentPayment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Email tasdiqlash — parol tiklash bilan bir xil naqsh (faqat hash saqlanadi)
model EmailVerificationToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Parolni tiklash: xom token emas, faqat sha256 hash saqlanadi
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/**
 * Kirilgan seans — bitta qurilmadagi bitta login.
 *
 * NEGA KERAK: JWT stateless bo'lgani uchun server qaysi qurilmalarda ochiq
 * seans borligini bilmasdi va "Chiqish" tugmasi tokenni bekor qilolmasdi —
 * u yana 7 kun (JWT_EXPIRES_IN) amal qilaverardi. Endi tokenda seans id'si
 * (`sid`) yuriydi va `authenticate` har so'rovda shu yozuvni tekshiradi:
 * bekor qilingan yoki uzoq harakatsiz qolgan seans darhol 401 oladi.
 *
 * DIQQAT: `LiveSession` (mentorning jonli darsi) butunlay boshqa narsa.
 */
model Session {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // Ro'yxatda "Chrome, Windows" ko'rinishida ko'rsatish uchun
  userAgent  String?
  ip         String?
  // Brauzerdagi anonim qurilma id (X-Device-Id) — "shu qurilma"ni ishonchli
  // belgilash uchun: userAgent bir nechta qurilmada bir xil bo'lishi mumkin
  deviceId   String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  // Eski yozuvlarni tozalash (clean:sessions) uchun
  @@index([lastSeenAt])
}

model Mentor {
  id            String   @id @default(cuid())
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?  @unique
  name          String
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  bio           Json
  photoUrl      String?
  // Rasm kadrga kesilganda markazda qoladigan nuqta (foizda) — User.focusX izohiga qarang
  focusX        Int      @default(50)
  focusY        Int      @default(50)
  specialty     Json
  position      Json?
  linkedinUrl   String?
  githubUrl     String?
  telegramUrl   String?
  order         Int      @default(0)
  featured      Boolean  @default(false)
  // Kurslar CourseMentor orqali — bitta kursda bir nechta mentor bo'lishi mumkin
  courseLinks   CourseMentor[]
  blogPosts     BlogPost[]
  liveSessions  LiveSession[]
  assignments   Assignment[]
  requests      MentorRequest[]
  // Mentor ayni paytda jamoa a'zosi ham bo'lishi mumkin (majburiy emas)
  teamProfile   TeamMember?
  groups        CourseGroup[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Course {
  id             String       @id @default(cuid())
  slug           String       @unique
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}. slug doim title.uz'dan hosil qilinadi.
  title          Json
  subtitle       Json?
  description    Json
  iconKey        String
  color          String
  bg             String
  border         String
  // NARX — ikki xil: `price` ONLAYN o'qish narxi, `offlinePrice` esa markazda
  // (offline guruhda) o'qish narxi. offlinePrice null bo'lsa offline uchun ham
  // `price` ko'rsatiladi. ONLINE kursda ikkinchisi, OFFLINE kursda birinchisi
  // shunchaki e'tiborga olinmaydi — `format` ga qarab.
  price          Decimal?
  offlinePrice   Decimal?
  isFree         Boolean      @default(true)
  currency       String       @default("UZS")
  durationMonths Int
  level          Level        @default(BEGINNER)
  // ONLINE kursga o'quvchi o'zi yozilaveradi; OFFLINE'da yozilish admin
  // orqali kechadi (CourseRequest). HYBRID'da tanlovni o'quvchi qiladi.
  format         CourseFormat @default(ONLINE)
  // Offline mashg'ulot manzili — ko'p tilli matn {uz, ru?, kaa?, en?}
  location       Json?
  rating         Float        @default(0)
  reviewsCount   Int          @default(0)
  studentsCount  Int          @default(0)
  views          Int          @default(0)
  likesCount     Int          @default(0)
  tags           String[]
  published      Boolean      @default(false)
  // BAYROQLAR — chalkashtirmang:
  //   published              = kurs saytda umuman KO'RINADIMI (false → hech kim ko'rmaydi)
  //   onlineEnrollmentOpen   = ko'rinadi, ONLAYN yozilish ochiqmi
  //   offlineEnrollmentOpen  = ko'rinadi, OFFLINE guruhga qabul ochiqmi
  //
  // Markazning yo'nalishlari doim ro'yxatda tursin (odam nima o'rgatilishini
  // bilsin), lekin guruh to'lganda yoki hali ochilmaganda "Tez orada" ko'rinsin.
  //
  // NEGA IKKITA BAYROQ: HYBRID kursda ikki xil qabul bor va ular BOG'LIQ EMAS —
  // onlayn guruh to'lib qolgani offline guruh ham yopiq degani emas (va aksincha).
  // Bitta umumiy bayroq bilan ikkalasini birdan yopishga majbur bo'lardik.
  // ONLINE kursda faqat birinchisi, OFFLINE kursda faqat ikkinchisi ma'noli
  // (`format` ga qarab) — ortiqchasi shunchaki e'tiborga olinmaydi.
  //
  // Mavjud yozilganlarga ta'sir qilmaydi — faqat YANGI yozilish to'xtaydi.
  onlineEnrollmentOpen  Boolean @default(true)
  offlineEnrollmentOpen Boolean @default(true)
  // GURUH SIG'IMI — bir vaqtda nechta o'quvchi o'qiy oladi (5-6 kishilik guruh).
  // null = cheklov yo'q (eski kurslar shunday qoladi).
  //
  // Onlayn va offline ALOHIDA hisoblanadi, xuddi yuqoridagi bayroqlar kabi:
  // onlayn guruh to'lgani offline guruh ham to'ldi degani emas.
  //
  // BAND JOY QANDAY SANALADI:
  //   onlayn  — PENDING yoki ACTIVE holatidagi Enrollment
  //   offline — ENROLLED holatidagi CourseRequest (offline'da Enrollment
  //             yaratilmaydi, yozilish admin bilan kelishiladi)
  // COMPLETED o'quvchi joyni BO'SHATADI — chegara "bir vaqtda o'qiydiganlar"
  // uchun, kursni umr bo'yi tamomlaganlar uchun emas.
  onlineSeats   Int?
  offlineSeats  Int?
  // Kursning mentorlari — CourseMentor izohiga qarang (bittasi "asosiy")
  mentors        CourseMentor[]
  modules        Module[]
  enrollments    Enrollment[]
  liveSessions   LiveSession[]
  assignments    Assignment[]
  announcements  Announcement[]
  reviews        CourseReview[]
  requests       CourseRequest[]
  groups         CourseGroup[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Kurs ↔ mentor: bitta kursni bir nechta mentor olib boradi.
//
// Ilgari bu `Course.mentorId` — bitta ustun edi. Amalda kurs ko'pincha
// jamoa bilan o'tiladi (asosiy mentor + yordamchi/amaliyot mentori), va
// ularning har biri o'z kabinetida shu kursni ko'rishi, savolga javob
// berishi, topshiriq berishi kerak.
//
// `isLead` — kursda ko'pi bilan BITTA mentorga qo'yiladi; buni servis
// qatlami (setCourseMentors) bitta tranzaksiyada ta'minlaydi, chunki
// Prisma sxemasi qisman (partial) noyob indeksni ifodalay olmaydi.
// U ikki joyda ishlaydi: sayt kartasida birinchi ko'rinadi va admin kurs
// nomidan sessiya/topshiriq yaratganda muallif sifatida shu tanlanadi.
model CourseMentor {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  mentor    Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId  String
  isLead    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  // Bitta mentor bitta kursga faqat bir marta biriktiriladi
  @@unique([courseId, mentorId])
  // "Mening kurslarim" — mentor kabinetidagi eng ko'p ishlatiladigan so'rov
  @@index([mentorId])
}

model CourseReview {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  rating    Int
  comment   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model LiveSession {
  id          String        @id @default(cuid())
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title       Json
  description Json?
  meetingUrl  String
  startsAt    DateTime
  durationMin Int           @default(60)
  status      SessionStatus @default(SCHEDULED)
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  mentor      Mentor        @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId    String
  // Bo'sh massiv = kursga yozilgan barcha faol o'quvchiga ochiq (standart).
  // To'ldirilsa — faqat shu userId'lar ko'radi (mentor aniq o'quvchilarni tanlagan).
  targetStudentIds String[] @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([courseId, startsAt])
}

model Module {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title       Json
  description Json?
  order       Int
  lessons     Lesson[]

  // Dastur HAR DOIM kurs bo'yicha va tartibda o'qiladi (kurs sahifasi, learn,
  // curriculum editor). PostgreSQL tashqi kalitni o'zi indekslamaydi —
  // indekssiz bu so'rovlar butun jadvalni skanerlardi.
  @@index([courseId, order])
}

model Lesson {
  id              String      @id @default(cuid())
  module          Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId        String
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title           Json
  order           Int
  contentType     ContentType @default(VIDEO)
  videoUrl        String?
  content         Json?
  durationMinutes Int?
  isFreePreview   Boolean     @default(false)
  progress        LessonProgress[]
  questions       LessonQuestion[]

  @@index([moduleId, order])
}

// O'quvchi ↔ mentor muloqoti: dars ostidagi savol-javob
model LessonQuestion {
  id         String    @id @default(cuid())
  lesson     Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId   String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  body       String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([lessonId, createdAt])
  @@index([userId])
}

enum MentorRequestStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  ACCEPTED
  RETURNED
}

// Mentor ↔ o'quvchi: kurs bo'yicha topshiriq (vazifa berish va tekshirish).
// Savol-javob (LessonQuestion) kabi to'g'ridan-to'g'ri muloqot kanali —
// shu sabab matnlar ko'p tilli Json emas, oddiy String.
model Assignment {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  mentor      Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId    String
  title       String
  description String
  // Qo'shimcha material havolasi (Google Docs, GitHub va h.k.)
  linkUrl     String?
  dueAt       DateTime?
  // Bo'sh massiv = kursga yozilgan barcha faol o'quvchiga (LiveSession patterni)
  targetStudentIds String[] @default([])
  submissions AssignmentSubmission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, createdAt])
  @@index([mentorId])
}

// O'quvchining topshiriq javobi. RETURNED bo'lsa qayta topshirish mumkin,
// ACCEPTED — yakuniy (o'zgartirib bo'lmaydi).
model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  content      String
  linkUrl      String?
  fileUrl      String?
  status       SubmissionStatus @default(SUBMITTED)
  grade        Int?
  feedback     String?
  reviewedAt   DateTime?
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId])
}

// Mentor ↔ admin aloqasi: mentorning rasmiy so'rovlari
model MentorRequest {
  id        String              @id @default(cuid())
  mentor    Mentor              @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId  String
  subject   String
  body      String
  status    MentorRequestStatus @default(OPEN)
  reply     String?
  repliedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([mentorId])
}

enum ConversationKind {
  // Ikki aniq foydalanuvchi orasidagi yozishma (talaba ↔ mentor)
  DIRECT
  // "Administratsiya" kanali — uni boshlagan foydalanuvchi bir tomonda,
  // ikkinchi tomonda esa BARCHA adminlar. Aniq admin biriktirilmaydi:
  // xabar javobsiz qolmasligi kerak, kim bo'sh bo'lsa o'sha javob beradi.
  ADMIN
}

/**
 * Rollar aro to'g'ridan-to'g'ri yozishma.
 *
 * Loyihada allaqachon uchta muloqot kanali bor edi (dars ostidagi savol,
 * mentorning adminga so'rovi, ochiq kontakt formasi) — lekin ularning
 * hech biri suhbat emas: har birida bitta savol va bitta javob maydoni.
 * Bu model o'sha kanallarni ALMASHTIRMAYDI, ular o'z kontekstida qoladi;
 * bu esa kontekstsiz, ko'p xabarli yozishma uchun.
 */
model Conversation {
  id            String                    @id @default(cuid())
  kind          ConversationKind          @default(DIRECT)
  /// Takroriy suhbat ochilmasligi uchun hisoblanadigan noyob kalit:
  /// DIRECT uchun "direct:<userId1>:<userId2>" (id'lar saralangan),
  /// ADMIN uchun "admin:<userId>". Noyoblik bazada — parallel ikki
  /// so'rov ham bitta suhbatga tushadi (upsert).
  pairKey       String                    @unique
  lastMessageAt DateTime                  @default(now())
  participants  ConversationParticipant[]
  messages      Message[]
  createdAt     DateTime                  @default(now())

  @@index([lastMessageAt])
}

// Suhbat ishtirokchisi va uning o'qish holati.
// ADMIN turidagi suhbatda adminlar uchun bu yozuv suhbat birinchi marta
// ochilganda yaratiladi — aks holda har yangi admin uchun barcha eski
// suhbatlarga yozuv qo'shib chiqish kerak bo'lardi.
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum CourseRequestStatus {
  NEW
  CONTACTED
  ENROLLED
  REJECTED
}

/**
 * Kursga qiziqqan odamning adminga so'rovi — ayniqsa OFFLINE kurslar uchun.
 *
 * Offline guruhga o'quvchi o'zi "yozilib" qo'ya olmaydi: joy, jadval va
 * to'lov admin bilan kelishiladi. Shuning uchun bu Enrollment emas —
 * to'lov/progress tizimiga tegmaydigan alohida murojaat.
 *
 * `userId` ixtiyoriy: saytga kirmagan mehmon ham telefon qoldirib
 * so'rov yubora oladi (aynan shu odamlar keyin ro'yxatdan o'tadi).
 */
model CourseRequest {
  id        String              @id @default(cuid())
  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  // O'quvchi tanlagan format — kurs HYBRID bo'lganda aynan shu qiymat muhim
  format    CourseFormat
  name      String
  phone     String
  email     String?
  note      String?
  status    CourseRequestStatus @default(NEW)
  reply     String?
  repliedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([courseId])
}

enum NotificationType {
  QUESTION_ANSWERED
  NEW_QUESTION
  ENROLLMENT_ACTIVATED
  RECEIPT_SUBMITTED
  MENTOR_REQUEST_REPLIED
  NEW_MENTOR_REQUEST
  SESSION_SCHEDULED
  ANNOUNCEMENT
  PAYMENT_REJECTED
  SUBSCRIPTION_ACTIVATED
  NEW_ASSIGNMENT
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_REVIEWED
  NEW_MESSAGE
  NEW_COURSE_REQUEST
}

// Kabinet ichidagi bildirishnomalar — har bir yozuv bitta foydalanuvchiga tegishli
model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  MENTORS
}

// Admin e'lonlari — yaratilganda auditoriyaga Notification sifatida tarqatiladi
model Announcement {
  id        String               @id @default(cuid())
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title     Json
  body      Json
  audience  AnnouncementAudience @default(ALL)
  course    Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId  String?
  createdAt DateTime             @default(now())
}

model LessonProgress {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  // Kompozit unikal indeks userId'dan boshlanadi, shuning uchun FAQAT lessonId
  // bo'yicha qidiruvga (dars o'chirilganda cascade) yaramaydi
  @@index([lessonId])
}

// Bosh sahifadagi "DATA LIFE'da bir kun" galereyasi — ofisdagi e'tiborli
// voqealar suratlari. Ko'rinishi Instagram "story" siga o'xshash: tepada
// bo'lakli progress chizig'i, o'zi almashib turadi, chapga/o'ngga suriladi.
//
// Nega alohida model: `Project` (portfolio) va `Partner` dan mutlaqo boshqa
// maqsad — bu yerda sana va qisqa izoh muhim, havola/tex-stack esa kerak emas.
model Moment {
  id         String   @id @default(cuid())
  imageUrl   String
  // Rasm kadrga kesilganda markazda qoladigan nuqta — User.focusX izohiga qarang
  focusX     Int      @default(50)
  focusY     Int      @default(50)
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title      Json
  caption    Json?
  // Voqea sanasi (rasm yuklangan kun emas) — kartada ko'rsatiladi
  happenedAt DateTime?
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, order])
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String?
  category   String
  order      Int      @default(0)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Project {
  id            String   @id @default(cuid())
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  title         Json
  category      String
  description   Json
  techStack     String[]
  screenshotUrl String
  liveUrl       String?
  repoUrl       String?
  // true bo'lsa kartada skrinshot o'rniga liveUrl to'g'ridan-to'g'ri iframe orqali
  // "jonli" ko'rsatiladi — ba'zi saytlar (X-Frame-Options/CSP) buni bloklashi mumkin,
  // shu holatlarda admin buni o'chirib skrinshotga qaytishi kerak.
  liveEmbed     Boolean  @default(false)
  order         Int      @default(0)
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  views         Int      @default(0)
  likesCount    Int      @default(0)
  team          TeamMemberProject[]
  createdAt     DateTime @default(now())
}

// Kompaniya jamoasi — mentor bo'lmagan xodimlar (dasturchi, dizayner, PM, HR...) ham
// shu yerda. Mentor modeli ataylab tegilmaydi: u faqat o'quv tomonini bildiradi,
// jamoa a'zosi ixtiyoriy ravishda mentorProfile'ga bog'lanadi (mentorId).
model TeamMember {
  id          String     @id @default(cuid())
  // Ommaviy sahifa manzili: /team/<slug>. Kabinet yo'llari bilan to'qnashmasligi
  // uchun validator zahiralangan so'zlarni (profile, directory...) rad etadi.
  slug        String     @unique
  name        String
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  position    Json
  bio         Json
  department  Department @default(ENGINEERING)
  // Rahbariyat/asoschilar bloki — sahifa boshida alohida ajratib ko'rsatiladi
  leadership  Boolean    @default(false)
  photoUrl    String?
  // Rasm kadrga kesilganda markazda qoladigan nuqta (foizda) — User.focusX izohiga qarang
  focusX      Int        @default(50)
  focusY      Int        @default(50)
  skills      String[]
  email       String?
  phone       String?
  linkedinUrl String?
  githubUrl   String?
  telegramUrl String?
  websiteUrl  String?
  joinedAt    DateTime?
  order       Int        @default(0)
  featured    Boolean    @default(false)
  published   Boolean    @default(true)
  // Kabinetga kirish uchun — a'zo o'z profilini shu akkaunt orqali tahrirlaydi
  user        User?      @relation(fields: [userId], references: [id])
  userId      String?    @unique
  mentor      Mentor?    @relation(fields: [mentorId], references: [id])
  mentorId    String?    @unique
  projects    TeamMemberProject[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([department, order])
}

// Kim qaysi loyihada, qanday rolda ishlagani. Oddiy ko'pga-ko'p emas — `role`
// maydoni sabab aniq (explicit) bog'lovchi jadval.
model TeamMemberProject {
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  // Loyihadagi roli, ko'p tilli — bo'sh bo'lsa a'zoning lavozimi ko'rsatiladi
  role         Json?
  order        Int        @default(0)

  @@id([teamMemberId, projectId])
  @@index([projectId])
}

enum CourseGroupStatus {
  // E'lon qilingan, hali boshlanmagan — o'quvchilar shu guruhga to'planadi
  PLANNED
  // Hozir o'qiyapti
  ACTIVE
  // Tugagan; a'zolari tarixda qoladi
  FINISHED
}

/**
 * Aniq guruh — "Python-3 kechki", 15-sentabrda boshlanadi, dush/chor/juma 18:00.
 *
 * NEGA KERAK: kursga qabul qilingan o'quvchi shu paytgacha "kursdagi
 * o'quvchi" edi, xolos — qachon, qayerda va kim bilan boshlashini tizim
 * bilmasdi. Bu ma'lumot faqat administratorning telefon qo'ng'irog'ida
 * yashardi. Guruh uni saqlaydigan joy: o'quvchi kabinetida jadvalini va
 * keyingi darsini ko'radi, admin esa kimni qaysi guruhga qo'yganini.
 *
 * JADVAL HAFTALIK, TAQVIM EMAS: `weekdays` + `startTime` takrorlanuvchi
 * qoidani beradi (LiveSession esa bitta aniq voqea). Ikkalasi bir-birini
 * almashtirmaydi — offline guruhning haftalik jadvali bor, onlayn jonli
 * dars esa sana-vaqtga bog'langan alohida hodisa.
 *
 * SIG'IM: `capacity` — SHU guruhdagi joy. Course.onlineSeats/offlineSeats
 * esa kursda ayni paytda o'qiy oladigan umumiy son (courseSeats.service.ts).
 * Ikkalasi bir-biriga xalaqit bermaydi: kursda joy bo'lib, tanlangan guruh
 * to'lgan bo'lishi mumkin — o'shanda o'quvchi boshqa guruhga qo'yiladi.
 */
model CourseGroup {
  id          String            @id @default(cuid())
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  // Ichki nom, tarjima qilinmaydi: "Python-3 kechki", "Frontend ertalabki"
  name        String
  format      EnrollmentFormat  @default(OFFLINE)
  // Guruhni olib boradigan mentor. Kursning mentorlaridan biri bo'ladi,
  // lekin majburiy emas — guruh mentor tayinlanmasdan oldin ham ochiladi
  mentor      Mentor?           @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  mentorId    String?
  status      CourseGroupStatus @default(PLANNED)
  startsAt    DateTime
  endsAt      DateTime?
  // Hafta kunlari: 0 = yakshanba ... 6 = shanba (JS Date.getDay bilan bir xil,
  // shuning uchun frontend keyingi darsni qo'shimcha moslashtirishsiz hisoblaydi)
  weekdays    Int[]             @default([])
  // "18:00" — mahalliy vaqt, sana emas. DateTime emasligi ataylab: haftalik
  // takrorlanadigan vaqtning sanasi yo'q, UTC'ga o'tkazish esa uni buzardi
  startTime   String?
  durationMin Int               @default(90)
  // Xona yoki manzil — kursning umumiy manzilidan farq qilishi mumkin
  room        String?
  capacity    Int?
  enrollments Enrollment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([courseId, status])
  @@index([mentorId])
}

/**
 * O'quvchining kursdagi o'rni — ONLAYN va OFFLINE guruh uchun BIR XIL yozuv.
 *
 * NEGA OFFLINE'DA HAM: ilgari offline yozilish faqat CourseRequest.ENROLLED
 * bo'lib qolardi, Enrollment yaratilmasdi. Natijada markazda o'qiyotgan
 * o'quvchi tizim uchun mavjud emas edi: mentorning o'quvchilar ro'yxatiga
 * tushmasdi (mentors.service.ts Enrollment'dan quriladi), jonli seansga
 * kira olmasdi, topshiriq ololmasdi, progress va sertifikat ham yo'q edi.
 * Har bir yangi imkoniyat ikki marta — Enrollment uchun va CourseRequest
 * uchun alohida — yozilishi kerak bo'lardi.
 *
 * Endi tasdiqlash ikkala formatda ham shu yozuvni yaratadi, `format` esa
 * farqni saqlaydi: darslar qayerda o'tishi, qaysi narx olingani va guruh
 * sig'imi qaysi tomondan sanalishi.
 *
 * Offline o'quvchi ham kurs materiallarini ko'radi: u markazda o'qigani
 * uchun ko'proq to'laydi (Course.offlinePrice), materialdan mahrum qilish
 * uchun sabab yo'q — kirish nazorati ikkala formatda bir xil.
 */
model Enrollment {
  id              String               @id @default(cuid())
  user            User                 @relation(fields: [userId], references: [id])
  userId          String
  course          Course               @relation(fields: [courseId], references: [id])
  courseId        String
  // Qaysi guruhda o'qiydi. Kurs HYBRID bo'lsa o'quvchi tanlagan tomon,
  // aks holda kursning o'z formati (courseSeats.service.ts: seatFormatFor).
  format          EnrollmentFormat     @default(ONLINE)
  // Aniq guruh (jadval, mentor, xona). Ixtiyoriy: onlayn o'quvchi ko'pincha
  // guruhsiz — o'z sur'atida o'qiydi. Guruh o'chirilsa yozilish saqlanadi
  // (SetNull), chunki o'quvchi kursda qolaveradi.
  group           CourseGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId         String?
  status          EnrollmentStatus     @default(PENDING)
  paymentStatus   PaymentStatus        @default(UNPAID)
  provider        String?
  providerRef     String?
  // KELISHILGAN SUMMA — kurs narxidan farq qilishi mumkin (chegirma, grant,
  // aka-uka uchun yon berish). Qarz aynan shundan hisoblanadi, kurs narxidan
  // emas: kurs narxi keyin ko'tarilsa allaqachon kelishilgan o'quvchining
  // qarzi o'sib ketmasligi kerak. null = eski yozuv yoki bepul kurs.
  priceAgreed     Decimal?
  // To'langan JAMI — to'lov daftarining keshlangan yig'indisi. Yagona manba
  // `payments`, bu ustun esa har ro'yxatda SUM qilmaslik uchun saqlanadi
  // (recalcEnrollmentPayment ikkalasini birga yangilaydi).
  amountPaid      Decimal?
  payments        EnrollmentPayment[]
  receiptUrl      String?
  rejectionReason String?
  enrolledAt      DateTime             @default(now())
  completedAt     DateTime?
  transactions    PaymentTransaction[]

  @@unique([userId, courseId])
  // Band joylarni hisoblash (getSeatsForCourses) HAR kurslar ro'yxatida
  // `courseId IN (...) AND status IN (...)` bo'yicha guruhlaydi. Yuqoridagi
  // unikal indeks userId'dan boshlangani uchun bunga yaramaydi — indekssiz
  // sahifaning har ochilishi butun Enrollment jadvalini o'qirdi.
  //
  // `format` oxirida turadi: [courseId, status] prefiksi eski so'rovlarga
  // avvalgidek xizmat qiladi, joy sanashda esa format ham shu indeksdan
  // filtrlanadi — ikkinchi indeks kerak emas.
  @@index([courseId, status, format])
  // Guruh a'zolarini sanash va ro'yxatlash uchun
  @@index([groupId])
}

/**
 * To'lov daftari — "kim, qachon, qancha to'ladi" ning yagona yozuvi.
 *
 * NEGA KERAK: ilgari yozilishda faqat `amountPaid` bitta son bo'lib turardi
 * va u "to'liq to'landi" degan taxminga tayanardi. Amalda markazda pul
 * BO'LIB to'lanadi: birinchi oyda oldindan, keyin qolganiga qarab. Bitta son
 * bunda nima to'langanini ham, qachon to'langanini ham ko'rsata olmasdi —
 * qarzdorlar ro'yxati esa umuman chiqmasdi.
 *
 * PaymentTransaction BILAN CHALKASHTIRMANG: u to'lov shlyuzining (Click/Payme)
 * protokol yozuvi — holat mashinasi, qaytarишlar, imzolar. Bu esa buxgalteriya
 * daftari: naqd pul ham, shlyuz to'lovi ham (confirmEnrollmentPayment orqali)
 * bir xil ko'rinishda shu yerga tushadi.
 */
model EnrollmentPayment {
  id           String        @id @default(cuid())
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  amount       Decimal
  method       PaymentMethod @default(CASH)
  // Kassada kim turgani — admin hisobi. Hisob o'chirilsa yozuv qoladi
  recordedBy   User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?
  note         String?
  // Pul HAQIQATDA kelgan sana — yozuv keyinroq kiritilishi mumkin
  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())

  @@index([enrollmentId, paidAt])
  @@index([recordedById])
}

enum PaymentProvider {
  CLICK
  PAYME
}

enum PaymentTxState {
  CREATED
  PERFORMED
  CANCELLED
  CANCELLED_AFTER_PERFORM
}

// Payme/Click webhook'lari orqali keladigan to'lov shlyuzi tranzaksiyasi holati.
// Ikkala protokol ham idempotentlikni talab qiladi — bir xil so'rov qayta kelsa
// bir xil javob qaytarilishi SHART, shuning uchun holat alohida saqlanadi.
model PaymentTransaction {
  id             String          @id @default(cuid())
  provider       PaymentProvider
  providerTxId   String
  // Aynan bittasi to'ldiriladi — buyurtma yo kurs yozilishi, yo obuna uchun
  enrollment     Enrollment?     @relation(fields: [enrollmentId], references: [id])
  enrollmentId   String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  amount         Decimal
  state          PaymentTxState  @default(CREATED)
  reason         Int?
  createTime     DateTime        @default(now())
  performTime    DateTime?
  cancelTime     DateTime?

  @@unique([provider, providerTxId])
  @@index([enrollmentId])
  @@index([subscriptionId])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

// Oylik obuna — faol bo'lsa barcha nashr qilingan kurslarga kirish beradi.
// Har bir kurs uchun alohida Enrollment avtomatik provisioning qilinadi
// (subscriptions.service.ts) — progress/sertifikat/jonli-dars/sharh
// tizimlariga tegilmasligi uchun.
model Subscription {
  id              String               @id @default(cuid())
  user            User                 @relation(fields: [userId], references: [id])
  userId          String
  status          SubscriptionStatus   @default(PENDING)
  startsAt        DateTime?
  expiresAt       DateTime?
  amountPaid      Decimal?
  provider        String?
  providerRef     String?
  receiptUrl      String?
  rejectionReason String?
  createdAt       DateTime             @default(now())
  transactions    PaymentTransaction[]

  @@index([userId])
}

// Bosh sahifa bo'limlari (hero_stats, about, services, why_us, contact) uchun
// admin tomonidan tahrirlanadigan tarkib — har bir bo'lim JSON blob sifatida saqlanadi.
model SiteSetting {
  id        String   @id @default(cuid())
  section   String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}
  role      Json
  avatarUrl String?
  // Rasm kadrga kesilganda markazda qoladigan nuqta (foizda) — User.focusX izohiga qarang
  focusX    Int      @default(50)
  focusY    Int      @default(50)
  text      Json
  rating    Int      @default(5)
  published Boolean  @default(true)
  order     Int      @default(0)
  likesCount Int     @default(0)
  createdAt DateTime @default(now())
}

// Yoqtirish/ko'rish hisoblagichlari qo'llanadigan kontent turlari.
// Polimorf yondashuv ATAYIN tanlangan: har bir tur uchun alohida Like jadvali
// (BlogPostLike, ProjectLike...) bir xil kodni to'rt marta takrorlashni talab
// qilardi. Buning evaziga foreign key yo'q — kontent o'chirilganda unga
// tegishli yozuvlar `engagement.service.ts` dagi `purgeEngagement()` orqali
// qo'lda tozalanadi.
// ESLATMA: `ContentType` nomi allaqachon band (Lesson uchun VIDEO/TEXT/...),
// shu sabab bu yerda `EngagementTarget` ishlatiladi.
enum EngagementTarget {
  BLOG_POST
  PROJECT
  COURSE
  TESTIMONIAL
}

// Bitta qurilmaning bitta kontentga qo'ygan yoqtirishi.
// `deviceId` — httpOnly cookie'dagi tasodifiy identifikator (login talab
// qilinmaydi): mehmon ham yoqtira olishi kerak. Cookie tozalansa qayta
// yoqtirish mumkin — bu ongli murosa, qat'iy noyoblik uchun login shart bo'lardi.
model ContentLike {
  id          String           @id @default(cuid())
  contentType EngagementTarget
  contentId   String
  deviceId    String
  createdAt   DateTime         @default(now())

  // Bir qurilma bir kontentni faqat bir marta yoqtira oladi — takroriy
  // bosish yozuvni o'chiradi (toggle)
  @@unique([contentType, contentId, deviceId])
  // Kontent bo'yicha sanash va o'chirish uchun
  @@index([contentType, contentId])
}

// Ko'rishlar dublikatini to'sish uchun.
//
// Ilgari bu blogda `bv_<id>` cookie'si bilan qilinardi — lekin frontend va
// backend turli domenlarda (vercel.app / datalife.uz ↔ onrender.com) va
// Safari krossdomen cookie'ni bloklaydi: o'sha brauzerlarda har yangilashda
// ko'rishlar soni oshib ketardi. Endi hisob `deviceId` (localStorage'dagi
// identifikator, `X-Device-Id` header orqali) bo'yicha bazada tekshiriladi.
model ContentView {
  id          String           @id @default(cuid())
  contentType EngagementTarget
  contentId   String
  deviceId    String
  // Oxirgi hisoblangan vaqt — 24 soatdan keyin ko'rish qayta sanaladi
  viewedAt    DateTime         @default(now())

  @@unique([contentType, contentId, deviceId])
  @@index([contentType, contentId])
}

// Kunlik kesim: "qachon" savoliga javob beradi.
//
// `Course.views` kabi hisoblagichlar faqat JAMI raqamni biladi, `ContentView`
// esa dublikat to'sish uchun `viewedAt` ni USTIGA yozadi — ya'ni tarix
// hech qayerda saqlanmasdi va "shu hafta o'sdimi yoki tushdimi" degan
// savolga javob yo'q edi. Har bir hisoblangan ko'rish/yoqtirish shu yerda
// ham kunlik yig'indiga qo'shiladi.
//
// `likes` MANFIY bo'lishi mumkin: yoqtirish olib tashlangan kun uchun -1
// yoziladi, ya'ni ustun kunlik SOF o'zgarishni bildiradi.
//
// Xom hodisalar (har ko'rish uchun bitta qator) ataylab saqlanmaydi — u
// cheksiz o'sardi; kunlik yig'indi grafiklar uchun yetarli.
model EngagementDaily {
  id          String           @id @default(cuid())
  contentType EngagementTarget
  contentId   String
  // Kun boshi (UTC yarim tuni) — vaqt qismisiz
  day         DateTime         @db.Date
  views       Int              @default(0)
  likes       Int              @default(0)

  @@unique([contentType, contentId, day])
  // Davr bo'yicha yig'ish (oxirgi 30 kun) — asosiy so'rov shakli
  @@index([day])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model BlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  // Ko'p tilli matn: {uz: string, ru?: string, kaa?: string, en?: string}. slug doim title.uz'dan hosil qilinadi.
  title        Json
  excerpt      Json
  content      Json
  category     String
  iconKey      String
  color        String
  bg           String
  border       String
  readMinutes  Int       @default(5)
  // Hisoblagichlar ATAYIN denormallashtirilgan (ContentLike'dan COUNT emas):
  // ro'yxat endpointlari yuklama ostida har element uchun sanashga chidamaydi
  views        Int       @default(0)
  likesCount   Int       @default(0)
  tags         String[]
  published    Boolean   @default(false)
  mentor       Mentor?   @relation(fields: [mentorId], references: [id])
  mentorId     String?
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
