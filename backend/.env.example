# --- Majburiy sozlamalar ---
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/datalife?schema=public"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# --- Qo'shimcha origin'lar (ixtiyoriy) ---
# CORS/CSRF uchun ruxsat etilgan qo'shimcha manzillar, vergul bilan.
# datalife.uz, www.datalife.uz va Vercel domenlari kodda allaqachon ruxsat etilgan —
# bu faqat yangi domen ulanganda kerak bo'ladi.
# EXTRA_ALLOWED_ORIGINS="https://yangi-domen.uz,https://www.yangi-domen.uz"

# --- Email (ixtiyoriy) ---
# Sozlanmasa email yuborilmaydi (dev'da xat mazmuni konsolga chiqadi).
# Brevo (brevo.com) HTTP API orqali yuboriladi — SMTP relay'dan farqli
# o'laroq IP manzil cheklovi yo'q, shuning uchun Render kabi o'zgaruvchan-IP
# hostingda ham qayta deploy'dan keyin qo'shimcha sozlash shart emas.
# BREVO_API_KEY: Brevo dashboard → SMTP & API → API Keys → Generate a new API key
# EMAIL_FROM: "Nomi <email>" — email Brevo'da "Senders" sifatida tasdiqlangan bo'lishi shart
#
# DIQQAT — spamga tushish sababi: bu yerga @gmail.com manzil yozilsa, Brevo xatni
# qabul qiladi va jurnalda "delivered" ko'rinadi, LEKIN Gmail 2024-yildan beri o'z
# domeni uchun DMARC'ni qat'iy tekshiradi va Brevo serveridan chiqqan "gmail.com"
# xatini spamga tashlaydi — odam xatni ko'rmaydi. Yagona to'g'ri yechim: Brevo →
# Senders, Domains & Dedicated IPs → Domains → datalife.uz ni qo'shib, u bergan
# DKIM/SPF yozuvlarini domen DNS'iga kiritish, keyin bu yerda no-reply@datalife.uz.
BREVO_API_KEY=
EMAIL_FROM="DATA LIFE <no-reply@datalife.uz>"

# --- Fayl xotirasi (ixtiyoriy, lekin Render/Railway'da MAJBURIY) ---
# Ephemeral hostingda lokal disk har deploy'da tozalanadi — yuklangan
# rasm/videolar yo'qoladi. Quyidagi IKKI provayderdan biri sozlansin.
#
# 1) Supabase Storage (TAVSIYA — Cloudinary O'zbekistondan bloklangan).
#    supabase.com'da bepul Project oching → Project Settings → API:
#    Project URL va "service_role" kaliti. Bucketlar birinchi yuklashda
#    avtomatik yaratiladi (datalife-images ochiq, datalife-videos yopiq,
#    datalife-apks ochiq).
#    DIQQAT: service_role kaliti loyihaga to'liq huquq beradi — faqat
#    backend env'ida tursin, frontendga/VITE_* ga hech qachon tushmasin.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET_IMAGES=datalife-images
# SUPABASE_BUCKET_VIDEOS=datalife-videos
# SUPABASE_BUCKET_APKS=datalife-apks
#
# 2) Cloudinary (muqobil). Ikkalasi sozlansa Cloudinary ustun turadi.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Yuklash hajmi chegaralari (ixtiyoriy, MB) ---
# DIQQAT: bulut xotiraning O'ZINING chegarasi ustun turadi. Supabase Free
# rejasida loyiha bo'yicha 50 MB — undan katta video yuklansa server qabul
# qiladi-yu, Supabase rad etadi. Shu holatda VIDEO_MAX_MB=50 qo'ying.
# IMAGE_MAX_MB=15
# VIDEO_MAX_MB=500
# APK_MAX_MB=200

# --- Sentry (ixtiyoriy) ---
# Production'da xatolarni kuzatish: sentry.io'da bepul loyiha oching,
# DSN'ni shu yerga qo'ying. Bo'sh qolsa Sentry yoqilmaydi.
SENTRY_DSN=

# --- Production (Render) uchun eslatma ---
# DATABASE_URL  = Render Postgres'ning "Internal Database URL"i
# NODE_ENV      = production   (majburiy: xato tafsilotlari mijozga chiqmasligi uchun)
# FRONTEND_URL  = https://datalife.uz
# JWT_SECRET    = kamida 32 belgili tasodifiy qiymat (server production'da tekshiradi),
#                 yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY = to'ldirilishi shart (yoki CLOUDINARY_*)
# BREVO_API_KEY va EMAIL_FROM = email ishlashi uchun to'ldirilishi shart (yuqoridagi izohga qarang)
# Build Command = npm install && npm run build && npx prisma migrate deploy
# Start Command = npm start
#
# Production'da seed kerak bo'lsa (demo parollar bloklanadi):
# SEED_FORCE=true ADMIN_PASSWORD=<kuchli parol> npm run seed
